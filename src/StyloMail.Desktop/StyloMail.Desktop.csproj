<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinExe rather than Exe so the Windows build opens without a console
      window behind it. It has no effect on macOS or Linux, where the window is
      the only thing that appears either way.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StyloMail.Desktop</RootNamespace>
    <AssemblyName>StyloMail.Desktop</AssemblyName>
    <!--
      Reflection bindings, matching mylo. The alternative compiles every binding
      against a declared type, which is stricter and better in a large app; here
      the cost is an x:DataType on every DataTemplate, and the benefit is caught
      only at build time in a window whose shapes are still moving.
    -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    DELIBERATELY EMPTY of ProjectReferences, and that is the load-bearing part
    of this file rather than an omission.

    Spec 10.1 decides that this console talks to the Host's HTTP API and
    nothing else. If it referenced StyloMail.Core, StyloMail.Host or the queue,
    the privilege model would exist in two places and could diverge, the API
    would never be forced to become sufficient for a headless deployment, and
    an action taken here would stop being the same audited request everything
    else makes. Every version of "just this one enum" ends at the same place.

    So the wire contracts are mirrored in Api/ instead, and the contract tests
    pin them. That duplication is the point: a copy that is tested against a
    stubbed handler proves what this client actually binds to, whereas
    referencing the Host's own DTOs would test the Host against itself and
    prove nothing.
  -->

  <ItemGroup>
    <!--
      Pinned to the versions the sibling mylo reader (lucidview/LucidReader)
      ships on this same SDK, which is the only reason to pick these exact
      numbers: that combination is known to build and run here.
    -->
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.0" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.0.321" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12" Condition="'$(Configuration)' == 'Debug'" />

    <!--
      Override transitive Tmds.DBus.Protocol 0.21.2 (GHSA-xrw6-gwf8-vvr9), the
      same override mylo and MarkdownViewer carry.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <!--
      Debug only, and it is the harness in Screenshot.cs rather than anything
      the app needs to run. It renders the window into a bitmap with no display
      and no window on screen, which is what lets a screenshot be taken without
      stealing focus on every build. Pinned to the app's Avalonia version: a
      mismatch here fails at startup with a TypeLoadException inside the
      headless clipboard stub, which reads as anything but a version problem.
    -->
    <!--
      The live UI harness: Playwright-style locators, real pointer input, YAML
      playback, a REPL and an MCP server, so the console can be driven and
      iterated rather than only photographed. Debug only, like everything else
      here. It adds the ux-test, ux-repl and ux-mcp command-line modes.

      Referenced as a package rather than as mylo references it. mylo takes a
      ProjectReference into a sibling checkout under external/, which works
      because that checkout is inside its own repository; here the same path
      would point outside this repository, so the shared solution build would
      break for anyone who did not have lucidview checked out beside it. A
      package keeps this lane's build self-contained.
    -->
    <PackageReference Include="Mostlylucid.Avalonia.UITesting" Version="1.7.1" />

    <!--
      Pinned to the app's Avalonia, and listed after the reference above because
      that package brings Avalonia.Headless 11.3.4 transitively. A headless
      clipboard stub one minor version behind the core fails at startup with a
      TypeLoadException, which reads as anything but a version problem. mylo
      carries the same pin for the same reason.
    -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.12" />
  </ItemGroup>

</Project>
