<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:StyloMail.Desktop.Views"
             x:Class="StyloMail.Desktop.Views.ConversationSignalsView">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Classes="paneTitle" Text="Thread signals" />
      <TextBlock Classes="paneDetail" TextWrapping="Wrap" Text="{Binding ThreadLabel}" />
      <TextBlock Classes="paneDetail" TextWrapping="Wrap" Text="{Binding ProvenanceLine}" />
      <TextBlock Classes="cardBody" TextWrapping="Wrap" Text="{Binding StatusLabel}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,0">
      <local:ToneSeriesChart Height="110"
                             IsVisible="{Binding HasToneSeries}"
                             Series="{Binding Tone}" />
      <TextBlock Classes="cardBody" TextWrapping="Wrap" Text="{Binding ToneRangeLabel}" />
    </StackPanel>

    <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
      <StackPanel Spacing="8">
        <TextBlock Classes="emptyDetail"
                   Margin="0,12"
                   IsVisible="{Binding ShowEmpty}"
                   Text="{Binding EmptyLabel}" />

        <ItemsControl ItemsSource="{Binding Points}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Classes="rowTitle" TextWrapping="Wrap" Text="{Binding Summary}" />
                  <TextBlock Classes="rowSubtitle" TextWrapping="Wrap" Text="{Binding MarkerCountLabel}" />

                  <ItemsControl ItemsSource="{Binding Markers}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="#FDECEA"
                                BorderBrush="{StaticResource ConsoleWarning}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,2"
                                Margin="0,0,6,4">
                          <TextBlock Classes="cardWarningText" Text="{Binding Label}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Classes="rowSubtitle" TextWrapping="Wrap" Text="{Binding ToneLabel}" />
                  <TextBlock Classes="cardWarningText"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasToneGap}"
                             Text="{Binding ToneGapReason}" />
                  <TextBlock Classes="signalReason" TextWrapping="Wrap" Text="{Binding AvailabilityLabel}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Classes="rowButton" Content="Refresh" Click="OnRefreshClick" />
    </StackPanel>
  </Grid>
</UserControl>
