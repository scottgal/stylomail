<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:StyloMail.Desktop.Views.Controls"
        xmlns:models="using:StyloMail.Desktop.Models"
        x:Class="StyloMail.Desktop.Views.MainWindow"
        Title="StyloMail"
        Width="1180" Height="720"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <controls:StatusBrushConverter x:Key="StatusBrush" />
    </Window.Resources>

    <!--
        The three-pane shape, modelled on Apple Mail: sidebar, list, detail.
        The grid lines are 1px separators rather than border thickness, so the
        divider between panes is the same hairline at every window size.
    -->
    <DockPanel>

        <!-- ============ status bar ============ -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <Ellipse Grid.Column="0"
                         Width="8" Height="8"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{Binding Status.Kind, Converter={StaticResource StatusBrush}}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="StatusHeadlineText" Classes="status" Text="{Binding StatusHeadline}" />
                    <TextBlock Classes="status" Text="·" />
                    <TextBlock x:Name="StatusDetailText" Classes="status" Text="{Binding StatusDetail}" />
                </StackPanel>

                <!--
                    Whether the screens here are following the Host or are a
                    photograph of it. Its own column rather than folded into the
                    connection status above, because the two answer different
                    questions and either can be the alarming one: a console can
                    be connected to a Host and no longer hearing from it, which
                    is exactly the state that a single "Connected" hides.

                    The detail is on the tooltip and in the model, which is
                    where the tests read it. The headline is what has to be on
                    screen, because "the feed stopped" is not something an
                    operator should have to hover to discover.
                -->
                <TextBlock x:Name="LiveFeedText"
                           Grid.Column="2"
                           Classes="status"
                           Classes.stale="{Binding ScreenMayBeStale}"
                           Margin="0,0,16,0"
                           Text="{Binding LiveFeedHeadline}"
                           ToolTip.Tip="{Binding LiveFeedDetail}" />

                <!--
                    What the console is doing about a feed that will not open.

                    A line of its own beside the headline, because the two answer
                    different questions and only one of them changes when an
                    operator presses Reconnect: the headline says whether the
                    screen can be trusted, and this says whether waiting is worth
                    anything or the operator has to act. Empty when nothing is
                    being retried, and present rather than hidden even then, for
                    the reason the Reconnect button below records.
                -->
                <TextBlock x:Name="LiveFeedRetryText"
                           Grid.Column="3"
                           Classes="status"
                           Margin="0,0,16,0"
                           Text="{Binding LiveFeedRetry}"
                           ToolTip.Tip="The console retries a connect you asked for on the same bounded cadence it uses on its own: four attempts at 0, 2, 10 and 30 seconds." />

                <TextBlock x:Name="HostAddressText"
                           Grid.Column="5"
                           Classes="status"
                           Text="{Binding HostAddress}" />

                <!--
                    The way back from a feed this console has stopped following.

                    It sits next to the feed headline because that is where the
                    operator is looking when they need it: after the retry budget
                    is spent the console gives up for good, and until this button
                    existed the only path that reconnected was the connection
                    dialog's own save, so getting back cost a credential the
                    console is built never to display.

                    Always present rather than shown only when the feed is down.
                    A control that appears and disappears cannot be asserted
                    absent by the harness (a locator matching no control at all
                    fails rather than reporting invisible), and re-reading the
                    Host is never the wrong thing to do anyway.

                    It reuses the stored key and never shows one: the reconnect
                    rebuilds the client from the settings and the keychain, which
                    is re-asserting a connection rather than re-proving identity.
                -->
                <Button x:Name="ReconnectButton"
                        Grid.Column="4"
                        Classes="rowButton"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="reconnect-console"
                        Content="Reconnect"
                        Click="OnReconnectClick"
                        ToolTip.Tip="Reconnect to this Host and read every screen again. Uses the stored key, which is never shown." />
            </Grid>
        </Border>

        <!--
            The result of the last action, and whether it worked. A failure is
            styled differently and never shares the look of a success: a console
            that rendered the Host's "was not applied" text the same way as
            "Paused" would leave an operator believing a quarantined message had
            been released when it is still in the queue.
        -->
        <Border DockPanel.Dock="Bottom"
                Classes="resultBar"
                Classes.failed="{Binding LastActionFailed}"
                IsVisible="{Binding HasLastActionResult}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ActionResultText"
                           Grid.Column="0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="{Binding LastActionResult}" />
                <Button Grid.Column="1" Classes="linkButton" Content="Dismiss" Click="OnDismissResultClick" />
            </Grid>
        </Border>

        <!--
            The confirmation. Nothing here is carried out on the first click:
            every action the console offers is consequential, and the ledger
            records only that it happened, not that it was meant.
        -->
        <Border x:Name="ActionConfirmBar"
                DockPanel.Dock="Bottom"
                Classes="actionBar"
                IsVisible="{Binding HasPendingAction}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:Name="PendingActionTitle" Classes="actionTitle" Text="{Binding PendingAction.Title}" />
                    <TextBlock x:Name="PendingActionConsequence"
                               Classes="actionConsequence"
                               TextWrapping="Wrap"
                               Text="{Binding PendingAction.Consequence}" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <TextBlock Classes="actionLabel"
                                   VerticalAlignment="Center"
                                   Text="Reason (recorded in the audit trail)" />
                        <TextBox x:Name="PendingReasonBox"
                                 Width="380"
                                 Watermark="Why this is being done"
                                 Text="{Binding PendingReason, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button x:Name="CancelActionButton" Content="Cancel" Click="OnCancelActionClick" />
                    <Button x:Name="ConfirmActionButton"
                            Content="Confirm"
                            Classes="primaryButton"
                            IsEnabled="{Binding CanConfirmAction}"
                            Click="OnConfirmActionClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="228,1,340,1,*">

            <!-- ============ 1. sidebar ============ -->
            <Border Grid.Column="0" Classes="sidebar">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="windowTitle" Text="StyloMail" />

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Classes="sectionHeader" Text="{Binding Title}" />

                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Button Grid.Column="0"
                                                                Classes="navRow"
                                                                Classes.selected="{Binding IsSelected}"
                                                                Click="OnSidebarItemClick">
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <Ellipse Grid.Column="0"
                                                                         Classes="blockedMarker"
                                                                         IsVisible="{Binding IsBlocked}" />

                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                                                                    <TextBlock Classes="rowSubtitle"
                                                                               AutomationProperties.AutomationId="{Binding DetailAutomationId}"
                                                                               Text="{Binding Detail}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>

                                                        <!--
                                                            Offered only where it would do
                                                            something. A control that appears on a
                                                            running account and an already-paused
                                                            one alike leaves an operator unable to
                                                            tell a no-op from a fault.
                                                        -->
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,8,0">
                                                            <Button Classes="rowButton"
                                                                    Content="Pause"
                                                                    AutomationProperties.AutomationId="{Binding PauseAutomationId}"
                                                                    IsVisible="{Binding CanPause}"
                                                                    Click="OnPauseSenderClick" />
                                                            <Button Classes="rowButton"
                                                                    Content="Resume"
                                                                    AutomationProperties.AutomationId="{Binding ResumeAutomationId}"
                                                                    IsVisible="{Binding CanResume}"
                                                                    Click="OnResumeSenderClick" />
                                                            <Button Classes="rowButton"
                                                                    Content="Edit"
                                                                    AutomationProperties.AutomationId="{Binding ProfileAutomationId}"
                                                                    IsVisible="{Binding IsSender}"
                                                                    Click="OnEditSenderClick" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Classes="separator" />

            <!-- ============ 2. list ============ -->
            <Border Grid.Column="2" Classes="list">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12,16,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <!--
                                    Named so a script can tell which
                                    destination the pane is showing. The
                                    sidebar repeats each entry's detail under
                                    its title, so an assertion on the text
                                    alone is satisfied by the sidebar and says
                                    nothing about the pane.
                                -->
                                <TextBlock x:Name="PaneTitleText"
                                           Classes="paneTitle"
                                           Text="{Binding SelectedPaneTitle}" />
                                <TextBlock x:Name="PaneDetailText"
                                           Classes="paneDetail"
                                           Text="{Binding SelectedPaneDetail}" />
                            </StackPanel>

                            <!--
                                Releasing is the one write action on a message, and it
                                is offered only for a message that is actually held in
                                quarantine.
                            -->
                            <Button x:Name="ReleaseMessageButton"
                                    Grid.Column="1"
                                    Classes="rowButton"
                                    VerticalAlignment="Center"
                                    Content="Release"
                                    IsVisible="{Binding CanReleaseSelected}"
                                    Click="OnReleaseClick" />
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Top" Height="1" Classes="separator" />

                    <!--
                        The page is short. A listing the Host had to drop rows
                        out of is not an empty listing, and it is not a filtered
                        one either: without this the operator reads a page of
                        twenty as the whole answer when the twenty-first could
                        not be decoded. Shown beside the rows, not instead of
                        them, because both facts matter at once.
                    -->
                    <Border x:Name="LedgerSkippedBlock"
                            DockPanel.Dock="Top"
                            Classes="cardWarning"
                            Margin="16,8,16,0"
                            IsVisible="{Binding HasSkippedDecisions}">
                        <TextBlock x:Name="LedgerSkippedText"
                                   Classes="cardBody"
                                   TextWrapping="Wrap"
                                   Text="{Binding LedgerSkippedNote}" />
                    </Border>

                    <!--
                        Shown when the pane has nothing to list, and says why.

                        Named on the container rather than only on the text
                        inside it, because a driving script needs to assert that
                        this whole block is absent when the pane has rows.
                        Control.IsVisible is the control's own property, not its
                        effective visibility, so EmptyListDetailText reports true
                        while its parent is hidden and an assertion on it passes
                        either way. That is ux-scripts/README.md's first lesson,
                        and this is the third time it has been walked into.
                    -->
                    <StackPanel x:Name="EmptyListBlock"
                                VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding !HasAnyRows}">
                        <TextBlock Classes="emptyTitle" Text="Nothing to list" />
                        <TextBlock x:Name="EmptyListDetailText"
                                   Classes="emptyDetail"
                                   Text="{Binding EmptyListDetail}" />

                        <!--
                            The readiness checks the Host failed, one per line.
                            The status bar says the Host cannot accept mail; this
                            is where an operator learns which check said so. The
                            model has carried FailedChecks as a list for exactly
                            this pane ("an operator scanning for a familiar
                            failure should not have to parse a sentence"), and
                            until now nothing rendered it, so "Connected, not
                            accepting mail" was the whole story on screen.
                        -->
                        <StackPanel x:Name="FailedChecksBlock"
                                    Spacing="2"
                                    HorizontalAlignment="Center"
                                    IsVisible="{Binding HasFailedChecks}">
                            <TextBlock x:Name="FailedChecksHeadingText"
                                       Classes="emptyDetail"
                                       Text="The Host reported these failed checks:" />
                            <ItemsControl ItemsSource="{Binding FailedChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="emptyDetail"
                                                   HorizontalAlignment="Center"
                                                   Text="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!--
                        The two listings share one cell rather than sitting
                        beside each other: only one is ever populated, because
                        applying either empties the other, and a Grid stops a
                        hidden list from stealing the height of a visible one.
                    -->
                    <Grid>
                    <ListBox x:Name="MessageList"
                             ItemsSource="{Binding Messages}"
                             SelectedItem="{Binding SelectedMessage}"
                             SelectionChanged="OnMessageSelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             IsVisible="{Binding HasMessages}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    Built from the fields the listing actually
                                    sends. No subject and no sender column,
                                    because a queued message carries neither and
                                    empty columns are a promise the console
                                    cannot keep.
                                -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Classes="rowTitle" Text="{Binding QueueId}" />
                                        <TextBlock Classes="rowSubtitle" Text="{Binding RecipientsLabel}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Classes="rowTitle" Text="{Binding StateLabel}" />
                                        <TextBlock Classes="rowSubtitle" Text="{Binding AttemptsLabel}" />

                                        <!--
                                            The ledger's row button, for the
                                            same reason and added the same way:
                                            a driving script clicks by raising
                                            the control's Click event, which a
                                            ListBoxItem has no handler for, and
                                            this is the affordance that makes
                                            "why was this held" reachable from
                                            the list rather than only from the
                                            ledger.
                                        -->
                                        <Button Classes="rowButton"
                                                HorizontalAlignment="Right"
                                                Margin="0,4,0,0"
                                                Content="Open message"
                                                AutomationProperties.AutomationId="{Binding OpenAutomationId}"
                                                Click="OnOpenMessageClick" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!--
                        The decision ledger. A row is a summary, so it carries
                        what a reviewer needs to decide whether to open it and
                        nothing more: the action, the risk index with its
                        caveat, the first reason in policy's own words, and a
                        count of coverage flags when the decision rests on
                        reduced coverage.
                    -->
                    <ListBox x:Name="DecisionList"
                             ItemsSource="{Binding Decisions}"
                             SelectedItem="{Binding SelectedDecision}"
                             SelectionChanged="OnDecisionSelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             IsVisible="{Binding HasDecisions}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4" Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Classes="rowTitle"
                                                   Text="{Binding HeadlineReason}"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Margin="8,0,0,0">
                                            <TextBlock Classes="rowTitle" Text="{Binding ActionLabel}" />
                                            <TextBlock Classes="rowSubtitle"
                                                       Text="{Binding AssessedAtLabel}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--
                                        The one line in this row with an id of
                                        its own. Every other line here is
                                        asserted by its whole text, which works
                                        while the text is the console's; this
                                        one carries the Host's arithmetic, so
                                        the smoke has to be able to find the
                                        line without pinning the number on it.
                                    -->
                                    <TextBlock Classes="rowSubtitle"
                                               AutomationProperties.AutomationId="ledger-risk-index"
                                               Text="{Binding RiskIndexLabel}" />

                                    <TextBlock Classes="rowSubtitle"
                                               Text="{Binding InternalMessageId}" />

                                    <TextBlock Classes="rowSubtitle"
                                               IsVisible="{Binding HasShadow}"
                                               Text="{Binding ShadowLabel}" />

                                    <!--
                                        Said only when it applies, like the
                                        post-delivery caveat: a marker on every
                                        row is one nobody reads.
                                    -->
                                    <TextBlock Classes="rowSubtitle"
                                               IsVisible="{Binding HasCoverage}"
                                               Text="{Binding CoverageLabel}" />

                                    <!--
                                        An explicit control rather than
                                        relying on selection alone. A row is a
                                        summary, so opening it costs a second
                                        round trip, and saying so is honest.
                                        It is also the only way a driving
                                        script can reach this: the harness
                                        clicks by raising the Click event,
                                        which a ListBoxItem has no handler
                                        for, so a click that selects a row
                                        silently does nothing.
                                    -->
                                    <Button Classes="rowButton"
                                            HorizontalAlignment="Right"
                                            Margin="0,4,0,0"
                                            Content="Open decision"
                                            AutomationProperties.AutomationId="{Binding OpenAutomationId}"
                                            Click="OnOpenDecisionClick" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="3" Classes="separator" />

            <!-- ============ 3. detail ============ -->
            <Border Grid.Column="4" Classes="detail">
              <!--
                  A DockPanel, not a Panel: the feedback bar docks to the bottom
                  and a Panel ignores docking, so the bar landed on top of the
                  decision instead of below it.
              -->
              <DockPanel>

                <!--
                    Feedback. The label feeds the Host's trusted baseline, so it
                    is scoped to a recipient rather than being a verdict about the
                    world, and the pane says which of the two kinds is selected.
                -->
                <Border DockPanel.Dock="Bottom"
                        Classes="feedbackBar"
                        IsVisible="{Binding HasDecision}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="actionLabel" Text="Record a label for this decision" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!--
                                Bound to the static lists rather than through
                                the model: a label set is not state, and an
                                instance property returning a constant is one
                                the analyzers correctly flag.
                            -->
                            <ComboBox x:Name="FeedbackLabelBox"
                                      Width="180"
                                      ItemsSource="{x:Static models:FeedbackDraft.AvailableLabels}"
                                      SelectedItem="{Binding Feedback.Label, Mode=TwoWay}" />
                            <ComboBox x:Name="FeedbackScopeBox"
                                      Width="160"
                                      ItemsSource="{x:Static models:FeedbackDraft.AvailableScopes}"
                                      SelectedItem="{Binding Feedback.Scope, Mode=TwoWay}" />
                            <TextBox x:Name="FeedbackRecipientBox"
                                     Width="220"
                                     Watermark="Recipient or identity"
                                     Text="{Binding Feedback.Recipient, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Classes="actionLabel" TextWrapping="Wrap" Text="{Binding Feedback.Description}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="FeedbackNoteBox"
                                     Width="480"
                                     Watermark="Note (optional)"
                                     Text="{Binding Feedback.Note, Mode=TwoWay}" />
                            <Button x:Name="RecordFeedbackButton"
                                    Classes="primaryButton"
                                    Content="Record"
                                    IsEnabled="{Binding CanSubmitFeedback}"
                                    Click="OnSubmitFeedbackClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Panel>

                <!-- Nothing to explain yet, and the reason is named. -->
                <StackPanel VerticalAlignment="Center"
                            Spacing="8"
                            IsVisible="{Binding !HasDecision}">
                    <TextBlock Classes="emptyTitle" Text="No decision open" />
                    <TextBlock Classes="emptyDetail" Text="{Binding DecisionUnavailableReason}" />
                </StackPanel>

                <ScrollViewer x:Name="DecisionPaneScroll" IsVisible="{Binding HasDecision}">
                    <StackPanel Margin="20" Spacing="0" DataContext="{Binding Decision}">

                        <TextBlock Classes="paneTitle" Text="Decision" />
                        <TextBlock Classes="paneDetail"
                                   Margin="0,2,0,14"
                                   Text="Why this message was held, or allowed." />

                        <!-- ===== what happened ===== -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="decisionAction" Text="{Binding ActionLabel}" />
                            <TextBlock Classes="paneDetail"
                                       VerticalAlignment="Center"
                                       Text="{Binding AssessmentId}" />
                        </StackPanel>

                        <TextBlock x:Name="RiskIndexText"
                                   Classes="paneDetail"
                                   Margin="0,2,0,4"
                                   Text="{Binding RiskIndexLabel}" />

                        <!--
                            What the index above was divided by. An index an
                            operator cannot check from what is on screen is one
                            they have to take on trust, and this says "not
                            recorded" rather than nothing when the decision
                            predates the arithmetic, because an unrecorded
                            divisor and a divisor of zero would otherwise read
                            the same.
                        -->
                        <TextBlock x:Name="RiskIndexArithmeticText"
                                   Classes="paneDetail"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="{Binding RiskIndexArithmetic}" />

                        <!--
                            The fraction itself, which is what the refusal text
                            quotes. The divisor above cannot stand in for it: the
                            divisor IS the fraction's numerator, so a pane holding
                            only that field has one term of two. Said as a sentence
                            for the same reason as the line above, so "not
                            recorded" is told apart from a measured zero and a
                            measured one.
                        -->
                        <TextBlock x:Name="CoveredWeightArithmeticText"
                                   Classes="paneDetail"
                                   Margin="0,0,0,4"
                                   TextWrapping="Wrap"
                                   Text="{Binding CoveredWeightArithmetic}" />

                        <!--
                            Seen after delivery. Every action this decision names
                            is post-hoc, and rendering it like any other would
                            tell an operator the system could have intervened when
                            it only reacted. Shown only when it is true, because a
                            caveat on every decision is one nobody reads.
                        -->
                        <Border x:Name="PostDeliveryBanner"
                                Classes="cardWarning"
                                Margin="0,0,0,10"
                                IsVisible="{Binding IsPostDelivery}">
                            <TextBlock Classes="cardBody"
                                       TextWrapping="Wrap"
                                       Text="{Binding PostDeliveryCaveat}" />
                        </Border>

                        <!--
                            A message can be assessed more than once. Showing
                            only the newest without saying so would hide that
                            anything changed.
                        -->
                        <Border Classes="cardWarning"
                                Margin="0,0,0,8"
                                IsVisible="{Binding HasHistory}">
                            <TextBlock Classes="cardBody" Text="{Binding HistoryNote}" />
                        </Border>

                        <!-- Shadow: what policy would have done while forwarding. -->
                        <Border Classes="cardWarning" IsVisible="{Binding ShadowLabel, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock Classes="cardBody" Text="{Binding ShadowLabel}" />
                        </Border>

                        <TextBlock Classes="sectionLabel" Text="Why" />
                        <TextBlock Classes="paneDetail"
                                   Margin="0,0,0,8"
                                   Text="In the order policy ranked them. Each reason shows the evidence that produced it." />

                        <ItemsControl ItemsSource="{Binding Reasons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Classes="cardTitle" Text="{Binding Code}" />
                                            <TextBlock Classes="cardBody" Text="{Binding Message}" />

                                            <ItemsControl ItemsSource="{Binding Evidence}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                            <TextBlock Grid.Column="0"
                                                                       Classes="signalId"
                                                                       Text="{Binding SignalId}" />

                                                            <!-- What this row is a slice OF. A signal
                                                                 id is not unique in one assessment: the
                                                                 behavioural evaluator emits one row per
                                                                 trend window, so without this the pane
                                                                 draws a burst and a slow trend identically.
                                                                 Absent when there is nothing to qualify,
                                                                 which is most rows, rather than saying
                                                                 "unknown". -->
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        Margin="10,0">
                                                                <TextBlock Classes="cardBody"
                                                                           Text="{Binding OriginLabel}" />
                                                                <TextBlock Classes="signalScope"
                                                                           Margin="8,0,0,0"
                                                                           IsVisible="{Binding ScopeLabel, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                                           Text="{Binding ScopeLabel}" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2"
                                                                       Classes="signalValue"
                                                                       Text="{Binding ValueLabel}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- A reason naming evidence that did not arrive says so. -->
                                            <TextBlock Classes="cardWarningText"
                                                       Margin="0,6,0,0"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasMissingEvidence}"
                                                       Text="{Binding MissingEvidenceLabel}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ===== measured dimensions ===== -->
                        <TextBlock Classes="sectionLabel" Text="Dimensions" />
                        <ItemsControl ItemsSource="{Binding Dimensions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Classes="cardBody" Text="{Binding Name}" />
                                            <TextBlock Classes="cardWarningText"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Qualifier}" />

                                            <!--
                                                What this row did to the index:
                                                said only on a row that did not
                                                enter it, and on a row whose
                                                arithmetic was never recorded.

                                                The distinction it exists for:
                                                a dimension measured and come
                                                back 0.0 was counted and dilutes
                                                the index, while one masked by
                                                decision 31 contributed nothing,
                                                and both arrive with the same
                                                score and the same availability.
                                                A reader checking the divisor
                                                would otherwise add the masked
                                                row's weight back in.
                                            -->
                                            <TextBlock Classes="cardWarningText"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       IsVisible="{Binding HasContributionNote}"
                                                       Text="{Binding ContributionLabel}" />
                                        </StackPanel>
                                        <!--
                                            ScoreLabel, never the raw score. A dimension
                                            that could not be measured reads "not measured"
                                            rather than 0, because a zero would say the
                                            semantic layer looked and found nothing.
                                        -->
                                        <TextBlock Grid.Column="1"
                                                   Classes="signalValue"
                                                   Text="{Binding ScoreLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ===== what qualifies all of it ===== -->
                        <TextBlock Classes="sectionLabel" Text="Coverage" Margin="0,16,0,4" />
                        <TextBlock Classes="paneDetail"
                                   Margin="0,0,0,6"
                                   IsVisible="{Binding !Coverage.Count}"
                                   Text="Nothing reduced the analysis: the whole message was examined." />
                        <ItemsControl ItemsSource="{Binding Coverage}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Classes="cardWarningText" Text="{Binding Name}" />
                                        <TextBlock Classes="cardBody" TextWrapping="Wrap" Text="{Binding Detail}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ===== provenance ===== -->
                        <TextBlock Classes="sectionLabel" Text="Versions" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="150,*" Margin="0,2">
                                        <TextBlock Grid.Column="0" Classes="cardBody" Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1" Classes="cardBody" TextWrapping="Wrap" Text="{Binding Display}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="sectionLabel" Text="Semantic cache" Margin="0,16,0,4" />
                        <TextBlock Classes="cardBody" TextWrapping="Wrap" Text="{Binding Cache.Display}" />
                    </StackPanel>
                </ScrollViewer>

                </Panel>
              </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
