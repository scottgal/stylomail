<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="StyloMail.Desktop.Views.ProxyAccountCreateDialog" Title="Create proxy account" Width="620" Height="700" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Cancel" Click="OnCancelClick"/><Button Content="Create account" Classes="primaryButton" Click="OnCreateClick"/></StackPanel><ScrollViewer><StackPanel Spacing="6"><TextBlock Classes="paneTitle" Text="Create proxy account"/><TextBlock Classes="cardBody" TextWrapping="Wrap" Text="Passwords and backend credentials are write-only. They are cleared immediately after submission and are never shown again."/><TextBlock Text="Login"/><TextBox x:Name="LoginBox"/><TextBlock Text="Client password"/><TextBox x:Name="ClientPasswordBox" PasswordChar="•"/><TextBlock Text="Backend account id"/><TextBox x:Name="BackendAccountIdBox"/><TextBlock Text="Provider"/><TextBox x:Name="ProviderBox"/><TextBlock Text="Credential discriminator"/><TextBox x:Name="DiscriminatorBox"/><TextBlock Text="Backend username"/><TextBox x:Name="BackendUsernameBox"/><TextBlock Text="Optional scopes"/><TextBox x:Name="ScopesBox"/><TextBlock Text="Backend secret"/><TextBox x:Name="BackendSecretBox" PasswordChar="•"/><TextBlock x:Name="ResultText" Classes="cardBody" TextWrapping="Wrap"/></StackPanel></ScrollViewer></DockPanel>
</Window>
