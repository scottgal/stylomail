<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:StyloMail.Desktop.Views"
             x:Class="StyloMail.Desktop.Views.ConversationPage">
  <Grid ColumnDefinitions="380,1,*">
    <local:ConversationListView Grid.Column="0" x:Name="ListView" />
    <Border Grid.Column="1" Classes="separator" />
    <TabControl Grid.Column="2">
      <TabItem Header="Thread signals"><local:ConversationSignalsView x:Name="SignalsView" /></TabItem>
      <TabItem Header="Element signals"><local:ConversationElementsView x:Name="ElementsView" /></TabItem>
    </TabControl>
  </Grid>
</UserControl>
