<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StyloMail.Host</RootNamespace>

    <!-- The CLI and the web host are one executable: `serve` runs Kestrel, everything else
         is a one-shot command. Keeping them in one project means the CLI cannot drift from
         the route surface it administers. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StyloMail.Core\StyloMail.Core.csproj" />
    <ProjectReference Include="..\StyloMail.Mime\StyloMail.Mime.csproj" />
    <ProjectReference Include="..\StyloMail.Policy\StyloMail.Policy.csproj" />
    <ProjectReference Include="..\StyloMail.Queue\StyloMail.Queue.csproj" />
    <ProjectReference Include="..\StyloMail.Persistence\StyloMail.Persistence.csproj" />
    <ProjectReference Include="..\StyloMail.Adaptive\StyloMail.Adaptive.csproj" />
    <ProjectReference Include="..\StyloMail.Assessment\StyloMail.Assessment.csproj" />

    <!-- The host composes the mail boundary, so it references the transport rather than the other
         way round: the transport has no idea it is being hosted, and its ingress sink port is
         deliberately an injected dependency rather than a queue it can reach. -->
    <ProjectReference Include="..\StyloMail.Transport\StyloMail.Transport.csproj" />

    <!-- Referenced so the host can compose the local decision model as a second semantic provider.
         Same direction as the transport above: the adapter has no idea it is being hosted, and
         which provider a deployment uses is a decision only the composition root is placed to
         make. It carries no credential, which is why its selection changes what the host requires
         to start. -->
    <ProjectReference Include="..\StyloMail.Nimble\StyloMail.Nimble.csproj" />

    <!-- And so the host can compose the two of them in the other order: a local judgment with a
         second opinion asked only where a deterministic rule says the local answer cannot be taken.
         The cascade references only the provider PORT and constructs no adapter of its own, so this
         adds a composition and not a third provider. -->
    <ProjectReference Include="..\StyloMail.Cascade\StyloMail.Cascade.csproj" />
  </ItemGroup>

</Project>
