         policy engine; the test reads the Host's own category catalogue so the mirrored labels and
         hard-floor flags cannot drift silently. -->
    <ProjectReference Include="..\..\src\StyloMail.Policy\StyloMail.Policy.csproj" />
  </ItemGroup>

</Project>
