# =============================================================================
# SECRETS — keep this block FIRST. See .styloagent/spec.md §11 (storage, privacy).
# StyloMail handles credentials for SMTP, tenants and the TypeSafe/Jev provider.
# Nothing in this block may ever be committed. If a secret is committed, treat it
# as compromised: rotate it, then rewrite history. Adding an ignore rule after the
# fact does NOT un-leak a secret.
# =============================================================================
*.pvt
*.key
*.pem
*.pfx
*.p12
*.snk
*.jks
*.keystore

# Environment / local configuration
.env
.env.*
!.env.example
appsettings.*.local.json
appsettings.Local.json
secrets.json
local.settings.json

